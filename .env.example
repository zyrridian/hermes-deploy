# Deployment settings only. Model API keys and bot tokens are NOT stored here;
# the setup wizard writes them to data/.env (inside the persistent data dir).
# `./manage.sh install` copies this file to .env for you.

# Tag that `./manage.sh update` follows. Use an X.Y.Z tag to move only when you choose.
HERMES_TRACK=nousresearch/hermes-agent:stable

# Written by `install` / `update`: the exact image digest that is running, so
# redeploys are reproducible. Leave empty; edit only to pin by hand.
HERMES_IMAGE=

TZ=UTC

# Where agent state and backups live. Defaults: ./data and ./backups
# HERMES_DATA_DIR=/srv/hermes/data
# BACKUP_DIR=/srv/hermes/backups

# Keep this many local backups (default 14).
# BACKUP_KEEP=14

# Encrypt backups with age (https://age-encryption.org). Backups contain your
# API keys, so do this before copying them anywhere.
#   age-keygen -o ~/hermes-backup-key.txt     # keep this file OFF the server
# BACKUP_AGE_RECIPIENT=age1...
# Needed only to restore encrypted backups:
# BACKUP_AGE_IDENTITY=/path/to/hermes-backup-key.txt

# Copy each backup off the machine with rclone (remote must already be configured).
# BACKUP_RCLONE_REMOTE=myremote:hermes-backups

# HERMES_API_PORT=8642
# HERMES_MEM_LIMIT=4g
# HERMES_CPUS=2.0
